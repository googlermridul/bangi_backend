# Copy this file to .env
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use the password you chose when you installed PostgreSQL.
# If the password has special characters (@ : / # ? %), URL-encode them (@ becomes %40).
DATABASE_URL=postgresql://postgres:password@localhost:5432/bangi

# Websites allowed to call this API (comma-separated, no trailing slash).
# Production example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Currency assumed when the user does not say one (e.g. "phone under 25k")
DEFAULT_CURRENCY=BDT

# OPTIONAL: leave empty to use the simple built-in parser.
# Add a key later to let an AI model understand questions better.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=